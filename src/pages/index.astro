---
import HomeLayout from '../layouts/HomeLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allThoughts = await getCollection('thoughts');

// Calculate reading time for each thought
const thoughtsWithReadingTime = await Promise.all(
  allThoughts.map(async (thought) => {
    const text = thought.body;
    const words = text.split(/\s+/).length;
    const readingTime = Math.ceil(words / 200); // 200 words per minute
    return { ...thought, readingTime };
  })
);

const recentThoughts = thoughtsWithReadingTime
  .filter(t => !t.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .slice(0, 4);

// Top of mind nodes - data-driven for easy editing
const topOfMindNodes = [
  {
    id: 'causal-inference',
    title: 'Causal Inference and Health Economics',
    blurb: `In Rachel Werner's lab at Penn, I'm studying how Medicaid payment rates affect nursing home staffing, quality, and resident outcomes, using multi-year panel data to get closer to causal answers than single-year snapshots allow. Along the way I'm building a working map of Medicare and Medicaid data.`
  },
  {
    id: 'single-cell',
    title: 'Single-Cell Tools and Bioinformatics',
    // TODO: replace "exploring" with what's actually built once scoped.
    blurb: `As a Convergence Scholar in Dan Beiting's lab at Penn Vet's Center for Host-Microbial Interactions, I'm extending CellxGene VIP, which hosts the lab's GutPath single-cell atlas, with analyses like cell-cell communication. I'm also exploring an AI layer that helps biologists ask questions of their own data directly.`
  },
  {
    id: 'generative-models',
    title: 'Generative Models for Biology',
    // TODO: add one line on my specific project with the Chatterjee lab.
    blurb: `I'm learning flow matching and diffusion, continuous and discrete, through Penn's CIS 6270 with Pranam Chatterjee. The course covers discrete generative models for designing peptide and protein therapeutics.`
  },
  {
    id: 'ai-safety',
    title: 'AI Safety in Healthcare',
    blurb: `I co-authored MultiTurnPSB, a benchmark that tests medical AI safety under multi-turn adversarial pressure (<a href="https://arxiv.org/abs/2606.02630" target="_blank" rel="noopener">arXiv 2606.02630</a>). I'm interested in what it takes for AI to be trustworthy with sensitive health data.`
  }
];
---

<HomeLayout title="Anushka Sheoran | Bioinformatics, AI and Strategy in Life Sciences, and AI Safety | Masters at University of Pennsylvania" description="Anushka Sheoran - Masters student focusing on bioinformatics, AI and strategy in life sciences, and AI safety at the University of Pennsylvania.">
  <div class="scroll-progress" id="scroll-progress"></div>
  <div class="gradient-mesh"></div>

  <!-- Cursor Light -->
  <div class="cursor-light" id="cursor-light"></div>

  <!-- Floating Elements -->
  <div class="floating-elements">
    <div class="float-circle float-1"></div>
    <div class="float-circle float-2"></div>
    <div class="float-circle float-3"></div>
    <div class="float-circle float-4"></div>
  </div>

  <!-- Under Construction Banner -->
  <div class="construction-banner">
    <span class="mono-lower">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
        <path d="M2 17l10 5 10-5"></path>
        <path d="M2 12l10 5 10-5"></path>
      </svg>
      under construction
    </span>
  </div>

  <div class="page-wrapper">
    <!-- Hero Landing Section -->
    <section class="hero-landing" id="hero-landing">
      <div class="hero-landing-content">
        <div class="profile-photo-large">
          <img src="/images/profile/profile-photo.jpg" alt="Anushka Sheoran" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
          <span class="mono-lower muted" style="display: none;">[photo]</span>
        </div>
        <h1 class="hero-name-large">Anushka Sheoran</h1>
        <p class="hero-tagline">
          Master's student in computer science at Penn, previously bioinformatics at UCSD.
        </p>
        <div class="location-tag">
          <span class="mono-lower">/currently in philadelphia</span>
        </div>
        <div class="scroll-indicator">
          <span class="mono-lower muted">scroll to explore</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 4V16M10 16L4 10M10 16L16 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- Top Navigation -->
    <nav class="top-nav pinned visible" id="top-nav">
      <div class="nav-left">
        <button class="theme-toggle-nav" id="theme-toggle-nav" aria-label="Toggle dark mode">
          <span class="theme-icon-nav">☾</span>
        </button>
        <a href="#home" class="nav-link active" data-tab="home">anushka sheoran</a>
      </div>
      <div class="nav-right">
        <a href="#thinking" class="nav-link" data-tab="thinking">thinking</a>
        <a href="/building" class="nav-link">building</a>
        <button class="pin-toggle active" id="pin-toggle" aria-label="Pin navigation" title="Unpin navigation">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 17v5"></path>
            <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path>
          </svg>
        </button>
      </div>
    </nav>

    <div class="layout">
      <!-- Left Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-content">
          <div class="timeline-section">
            <p class="section-marker mono-lower muted">academic journey</p>
            <div class="timeline">
              <div class="timeline-step">
                <div class="timeline-dot">
                  <img src="/images/logos/highschool-logo.png" alt="High School" class="timeline-logo" onerror="this.style.display='none'">
                </div>
                <span class="timeline-label">high school in canada</span>
              </div>
              <div class="timeline-line"></div>
              <div class="timeline-step">
                <div class="timeline-dot">
                  <img src="/images/logos/ucsd-logo.png" alt="UCSD" class="timeline-logo" onerror="this.style.display='none'">
                </div>
                <span class="timeline-label">ucsd bioinformatics</span>
              </div>
              <div class="timeline-line"></div>
              <div class="timeline-step">
                <div class="timeline-dot active">
                  <img src="/images/logos/penn-logo.png" alt="Penn" class="timeline-logo timeline-logo-penn" onerror="this.style.display='none'">
                </div>
                <span class="timeline-label">university of pennsylvania cs</span>
              </div>
            </div>
          </div>

          <div class="contact-section">
            <a href="#" class="contact-link" id="email-link" data-user="asheoran" data-domain="seas.upenn.edu">asheoran [at] seas.upenn.edu</a>
            <a href="https://github.com/asheorann" target="_blank" rel="noopener" class="contact-link">github</a>
            <a href="https://www.linkedin.com/in/anushka-sheoran" target="_blank" rel="noopener" class="contact-link">linkedin</a>
          </div>

        </div>
      </aside>

      <!-- Main Content -->
      <main class="main-content">

        <!-- Default Home View -->
        <section class="tab-section" id="home-view">
          <div class="intro-full">
            <p>
              Master's student in computer science at Penn, previously bioinformatics at UCSD. Currently working at the intersection of AI and biology, across healthcare policy, single-cell tools, generative models, and AI safety.
            </p>
            <p>
              Outside school, I work at Clariem on AI for pharma and life sciences, and I run the Claude Builder Club at Penn.
            </p>
            <p class="intro-aside">
              I enjoy learning broadly about how the world works, partly because it's fun, partly because it helps me find places where I can contribute. Don't hesitate to reach out :)
            </p>
          </div>

          <!-- Top of Mind Mind-Map Section -->
          <section class="top-of-mind-section" aria-label="Currently top of mind">
            <h2 class="section-heading mono-lower">top of mind</h2>

            <!-- Desktop: Mind-map layout -->
            <div class="mindmap-container" aria-hidden="false">
              <!-- SVG connections -->
              <svg class="mindmap-lines" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid meet">
                <line class="mindmap-line" x1="200" y1="150" x2="80" y2="60" />
                <line class="mindmap-line" x1="200" y1="150" x2="320" y2="60" />
                <line class="mindmap-line" x1="200" y1="150" x2="80" y2="240" />
                <line class="mindmap-line" x1="200" y1="150" x2="320" y2="240" />
              </svg>

              <!-- Center label -->
              <div class="mindmap-center">
                <span class="mono-lower">AI x Bio</span>
              </div>

              <!-- Nodes -->
              <div class="mindmap-nodes">
                {topOfMindNodes.map((node, index) => (
                  <div class={`mindmap-node mindmap-node-${index + 1}`} data-node-id={node.id}>
                    <button
                      class="mindmap-node-button"
                      aria-expanded="false"
                      aria-controls={`blurb-${node.id}`}
                    >
                      {node.title}
                    </button>
                    <div
                      class="mindmap-blurb"
                      id={`blurb-${node.id}`}
                      role="region"
                      aria-hidden="true"
                    >
                      <p set:html={node.blurb} />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Mobile: Grid/card layout -->
            <div class="mindmap-mobile">
              <p class="mindmap-mobile-center mono-lower muted">AI x Bio</p>
              <div class="mindmap-mobile-grid">
                {topOfMindNodes.map((node) => (
                  <div class="mindmap-mobile-card">
                    <h3>{node.title}</h3>
                    <p set:html={node.blurb} />
                  </div>
                ))}
              </div>
            </div>
          </section>

          <h2 class="section-heading mono-lower">selected projects</h2>
          {featuredProjects.length > 0 ? (
            <div class="project-grid">
              {featuredProjects.map(project => (
                <article class="project-card">
                  <div class="project-content">
                    <div class="project-header">
                      <h3>
                        {project.data.hasFullPage ? (
                          <a href={`/building/${project.slug}`}>{project.data.title}</a>
                        ) : (
                          <span>{project.data.title}</span>
                        )}
                      </h3>
                      <div class="project-tags">
                        {project.data.tags.map(tag => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    </div>
                    <p class="project-summary">{project.data.summary}</p>
                    {project.data.links && project.data.links.length > 0 && (
                      <div class="project-links">
                        {project.data.links.map(link => (
                          <a href={link.url} target="_blank" rel="noopener" class="project-link-item">[ {link.label} ]</a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="muted">[No projects yet]</p>
          )}

          <h2 class="section-heading mono-lower" style="margin-top: 3rem;">community</h2>
          <div class="community-section">
            <div class="community-photo-container">
              <img src="/images/community/community-photo.jpeg" alt="Penn Claude Builder Club board, May 2026" class="community-photo" />
              <p class="community-photo-caption mono-lower muted">penn CBC board, may 2026</p>
            </div>

            <div class="community-subsection">
              <h3 class="community-subsection-label mono-lower muted">at penn</h3>
              <ul class="community-list">
                <li>Anthropic Campus Ambassador & <a href="https://penncbc.com" target="_blank" rel="noopener">claude builder club</a> president <span class="muted">(since jan 2026)</span></li>
                <li>Penn Biotech Group <span class="muted">consultant (fall 2025)</span></li>
                <li>Penn Hindu Yuva <span class="muted">member (2025 to 2026)</span></li>
                <li>Curious Cardinals <span class="muted">mentor for high schoolers (since march 2026)</span></li>
              </ul>
            </div>

            <div class="community-subsection">
              <h3 class="community-subsection-label mono-lower muted">at ucsd</h3>
              <ul class="community-list community-list-quiet">
                <li>Undergraduate Bioinformatics Club <span class="muted">VP (2024)</span></li>
                <li>Triton NeuroTech <span class="muted">secretary (fall 2023)</span></li>
                <li>Phi Beta Lambda <span class="muted">VP (2021 to 2023)</span></li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Thinking Tab -->
        <section class="tab-section" id="thinking" style="display: none;">
          <h2 class="section-heading mono-lower">recent thinking</h2>
          {recentThoughts.length > 0 ? (
            <div class="thought-list">
              {recentThoughts.map(thought => (
                <article class="thought-card">
                  <div class="thought-meta">
                    <time class="mono-lower muted">
                      {thought.data.date.toLocaleDateString('en-US', {
                        month: 'short',
                        year: 'numeric'
                      })}
                    </time>
                    <span class="reading-time mono-lower muted">
                      {thought.readingTime} min read
                    </span>
                    <span class="status-badge mono-lower">
                      {thought.data.status}
                    </span>
                  </div>
                  <h3>
                    <a href={`/thinking/${thought.slug}`}>{thought.data.title}</a>
                  </h3>
                  <p class="excerpt">{thought.data.excerpt}</p>
                </article>
              ))}
            </div>
          ) : (
            <p class="muted">[No posts yet]</p>
          )}
        </section>
      </main>
    </div>
  </div>

  <script>
    const themeToggleNav = document.getElementById('theme-toggle-nav');
    const sidebar = document.querySelector('.sidebar') as HTMLElement | null;
    const scrollProgress = document.getElementById('scroll-progress');
    const topNav = document.getElementById('top-nav');
    const heroLanding = document.getElementById('hero-landing');
    const pinToggle = document.getElementById('pin-toggle');
    const cursorLight = document.getElementById('cursor-light');

    let currentTab = 'home';
    let isNavPinned = true;

    // Cursor light effect
    document.addEventListener('mousemove', (e) => {
      if (cursorLight) {
        cursorLight.style.left = e.clientX + 'px';
        cursorLight.style.top = e.clientY + 'px';
      }
    });

    // Email obfuscation
    const emailLink = document.getElementById('email-link');
    if (emailLink) {
      const user = emailLink.getAttribute('data-user');
      const domain = emailLink.getAttribute('data-domain');
      emailLink.addEventListener('click', (e) => {
        e.preventDefault();
        window.location.href = 'mailto:' + user + '@' + domain;
      });
    }

    // Mind-map node interaction
    const mindmapNodes = document.querySelectorAll('.mindmap-node-button');
    let activeNode: HTMLElement | null = null;

    function closeAllBlurbs() {
      mindmapNodes.forEach(btn => {
        btn.setAttribute('aria-expanded', 'false');
        const blurbId = btn.getAttribute('aria-controls');
        if (blurbId) {
          const blurb = document.getElementById(blurbId);
          if (blurb) {
            blurb.setAttribute('aria-hidden', 'true');
          }
        }
      });
      activeNode = null;
    }

    function toggleBlurb(button: HTMLElement) {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      const blurbId = button.getAttribute('aria-controls');
      const blurb = blurbId ? document.getElementById(blurbId) : null;

      // Close all others first
      closeAllBlurbs();

      // If it was closed, open it
      if (!isExpanded && blurb) {
        button.setAttribute('aria-expanded', 'true');
        blurb.setAttribute('aria-hidden', 'false');
        activeNode = button;
      }
    }

    mindmapNodes.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleBlurb(btn as HTMLElement);
      });

      btn.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          closeAllBlurbs();
        }
      });
    });

    // Close blurbs when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.mindmap-node')) {
        closeAllBlurbs();
      }
    });

    // Pin toggle functionality
    pinToggle?.addEventListener('click', () => {
      isNavPinned = !isNavPinned;
      if (isNavPinned) {
        pinToggle.classList.add('active');
        topNav?.classList.add('pinned');
        pinToggle.setAttribute('title', 'Unpin navigation');
      } else {
        pinToggle.classList.remove('active');
        topNav?.classList.remove('pinned');
        pinToggle.setAttribute('title', 'Pin navigation');
      }
    });

    // Scroll handling
    window.addEventListener('scroll', () => {
      const scrollY = window.pageYOffset;
      const heroHeight = heroLanding ? heroLanding.offsetHeight : 0;

      // Show navigation when scrolled past hero (only on home tab) or when pinned
      if (topNav) {
        if (isNavPinned) {
          // Always visible when pinned
          topNav.classList.add('visible');
        } else if (currentTab === 'home') {
          // Normal scroll behavior on home
          if (scrollY > heroHeight - 100) {
            topNav.classList.add('visible');
            // Trigger sidebar and home view animations when nav appears
            if (sidebar && !sidebar.classList.contains('animate')) {
              sidebar.classList.add('animate');
            }
            if (homeView && !homeView.classList.contains('animate')) {
              homeView.classList.add('animate');
            }
          } else {
            topNav.classList.remove('visible');
          }
        }
      }

      // Update scroll progress indicator
      const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (scrollY / windowHeight) * 100;
      if (scrollProgress) {
        scrollProgress.style.width = scrolled + '%';
      }
    });

    // Tab switching
    const navLinks = document.querySelectorAll('.nav-link[data-tab]');
    const homeView = document.getElementById('home-view');
    const thinkingSection = document.getElementById('thinking');
    const mainContent = document.querySelector('.main-content');

    // Initialize animations if nav is pinned on load
    if (isNavPinned) {
      if (sidebar && !sidebar.classList.contains('animate')) {
        sidebar.classList.add('animate');
      }
      if (homeView && !homeView.classList.contains('animate')) {
        homeView.classList.add('animate');
      }
    }

    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();

        // Update active link
        navLinks.forEach(l => l.classList.remove('active'));
        link.classList.add('active');

        // Show corresponding section
        const tabName = link.getAttribute('data-tab');
        currentTab = tabName!;

        if (tabName === 'home') {
          // Show hero landing and scroll to top
          if (heroLanding) heroLanding.style.display = 'flex';
          homeView!.style.display = 'block';
          thinkingSection!.style.display = 'none';
          if (sidebar) sidebar.style.display = 'block';
          mainContent!.classList.remove('full-width');
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // Hide nav initially unless pinned, will show on scroll
          if (!isNavPinned) {
            topNav!.classList.remove('visible');
          }
        } else if (tabName === 'thinking') {
          // Hide hero landing
          if (heroLanding) heroLanding.style.display = 'none';
          homeView!.style.display = 'none';
          thinkingSection!.style.display = 'block';
          if (sidebar) sidebar.style.display = 'none';
          mainContent!.classList.add('full-width');
          topNav!.classList.add('visible');

          // Trigger animations
          thinkingSection!.classList.remove('animate');
          setTimeout(() => {
            thinkingSection!.classList.add('animate');
          }, 10);
        }
      });
    });

    // Theme toggle
    const getTheme = () => localStorage.getItem('theme') || 'light';
    const setTheme = (theme: string) => {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      if (themeToggleNav) {
        const icon = themeToggleNav.querySelector('.theme-icon-nav');
        if (icon) {
          icon.textContent = theme === 'dark' ? '☀' : '☾';
        }
      }
    };

    // Initialize theme
    setTheme(getTheme());

    // Toggle theme
    themeToggleNav?.addEventListener('click', () => {
      const currentTheme = getTheme();
      setTheme(currentTheme === 'dark' ? 'light' : 'dark');
    });
  </script>
</HomeLayout>

<style>
  .page-wrapper {
    width: 100%;
    position: relative;
  }

  /* Gradient Mesh Background */
  .gradient-mesh {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.35;
    background:
      radial-gradient(at 20% 30%, rgba(168, 181, 217, 0.15) 0px, rgba(168, 181, 217, 0.08) 30%, transparent 60%),
      radial-gradient(at 80% 20%, rgba(168, 181, 217, 0.12) 0px, rgba(168, 181, 217, 0.06) 30%, transparent 60%),
      radial-gradient(at 40% 80%, rgba(184, 168, 201, 0.1) 0px, rgba(184, 168, 201, 0.05) 30%, transparent 60%),
      radial-gradient(at 90% 70%, rgba(168, 181, 217, 0.1) 0px, rgba(168, 181, 217, 0.04) 30%, transparent 60%);
    animation: meshShift 20s ease-in-out infinite;
    transition: opacity 400ms ease;
    filter: blur(2px);
  }

  [data-theme="dark"] .gradient-mesh {
    opacity: 0.2;
    background:
      radial-gradient(at 20% 30%, rgba(168, 181, 217, 0.08) 0px, transparent 50%),
      radial-gradient(at 80% 20%, rgba(168, 181, 217, 0.06) 0px, transparent 50%),
      radial-gradient(at 40% 80%, rgba(184, 168, 201, 0.05) 0px, transparent 50%),
      radial-gradient(at 90% 70%, rgba(168, 181, 217, 0.05) 0px, transparent 50%);
  }

  @keyframes meshShift {
    0%, 100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(2%, -2%);
    }
    66% {
      transform: translate(-2%, 2%);
    }
  }

  /* Floating Elements */
  .floating-elements {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .float-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.45;
    filter: blur(60px);
  }

  .float-1 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(168, 181, 217, 0.3) 0%, rgba(168, 181, 217, 0.15) 50%, transparent 100%);
    top: 10%;
    right: 15%;
    animation: float1 25s ease-in-out infinite;
  }

  .float-2 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(184, 168, 201, 0.28) 0%, rgba(184, 168, 201, 0.12) 50%, transparent 100%);
    bottom: 15%;
    left: 10%;
    animation: float2 30s ease-in-out infinite;
  }

  .float-3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(168, 181, 217, 0.25) 0%, rgba(168, 181, 217, 0.1) 50%, transparent 100%);
    top: 50%;
    left: 5%;
    animation: float3 35s ease-in-out infinite;
  }

  .float-4 {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(184, 168, 201, 0.32) 0%, rgba(184, 168, 201, 0.14) 50%, transparent 100%);
    bottom: 25%;
    right: 20%;
    animation: float4 28s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(-30px, 40px) scale(1.1);
    }
    66% {
      transform: translate(40px, -30px) scale(0.9);
    }
  }

  @keyframes float2 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(50px, -50px) scale(1.15);
    }
  }

  @keyframes float3 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(40px, -20px) scale(0.85);
    }
    66% {
      transform: translate(-20px, 40px) scale(1.1);
    }
  }

  @keyframes float4 {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(-40px, -30px) scale(1.05);
    }
    75% {
      transform: translate(30px, 40px) scale(0.95);
    }
  }

  [data-theme="dark"] .float-circle {
    opacity: 0.25;
  }

  /* Cursor Light */
  .cursor-light {
    position: fixed;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(108, 121, 157, 0.12) 0%, rgba(124, 108, 141, 0.08) 35%, rgba(108, 121, 157, 0.05) 60%, transparent 80%);
    pointer-events: none;
    z-index: 1;
    transform: translate(-50%, -50%);
    transition: opacity 300ms ease, background 300ms ease, filter 300ms ease;
    opacity: 0;
    mix-blend-mode: darken;
    filter: blur(25px);
  }

  [data-theme="dark"] .cursor-light {
    background: radial-gradient(circle, rgba(168, 181, 217, 0.22) 0%, rgba(184, 168, 201, 0.16) 30%, rgba(168, 181, 217, 0.1) 50%, transparent 75%);
    mix-blend-mode: lighten;
    filter: blur(30px);
  }

  @media (hover: hover) {
    .cursor-light {
      opacity: 1;
    }
  }

  /* Construction Banner */
  .construction-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(232, 181, 99, 0.15);
    border-bottom: 1px solid rgba(232, 181, 99, 0.3);
    backdrop-filter: blur(10px);
    padding: 0.5rem;
    text-align: center;
    z-index: 1001;
    animation: fadeInDown 600ms ease forwards;
  }

  .construction-banner span {
    color: #D4941E;
    font-size: 0.8125rem;
  }

  [data-theme="dark"] .construction-banner {
    background: rgba(232, 181, 99, 0.1);
    border-bottom: 1px solid rgba(232, 181, 99, 0.2);
  }

  /* Scroll Progress Indicator */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-secondary) 100%);
    z-index: 1002;
    transition: width 100ms ease-out;
    box-shadow: 0 0 10px var(--accent);
  }

  /* Intro Section */
  .intro-full {
    margin-bottom: 3rem;
    padding: 1.5rem;
    background: var(--surface);
    border-radius: 6px;
    border: 1px solid var(--border);
    opacity: 0;
    transform: translateY(20px);
  }

  #home-view.animate .intro-full {
    animation: fadeInUp 800ms ease forwards;
    animation-delay: 200ms;
  }

  .intro-full p {
    line-height: 1.6;
    margin: 0;
    font-size: 1rem;
  }

  .intro-full p + p {
    margin-top: 0.75rem;
  }

  .intro-aside {
    margin-top: 1.75rem !important;
  }

  /* Top of Mind Mind-Map Section */
  .top-of-mind-section {
    margin-bottom: 3rem;
    opacity: 0;
    transform: translateY(20px);
  }

  #home-view.animate .top-of-mind-section {
    animation: fadeInUp 800ms ease forwards;
    animation-delay: 400ms;
  }

  .top-of-mind-section .section-heading {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  /* Desktop mind-map container */
  .mindmap-container {
    position: relative;
    width: 100%;
    height: 320px;
    background: var(--surface);
    border-radius: 6px;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  /* SVG connection lines */
  .mindmap-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .mindmap-line {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.5;
  }

  /* Center label */
  .mindmap-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .mindmap-center span {
    font-size: 0.8125rem;
    color: var(--accent);
  }

  /* Node positioning */
  .mindmap-nodes {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .mindmap-node {
    position: absolute;
    z-index: 3;
  }

  /* Expanded node comes to front */
  .mindmap-node:has(.mindmap-node-button[aria-expanded="true"]) {
    z-index: 10;
  }

  /* Position nodes in corners */
  .mindmap-node-1 { top: 8%; left: 5%; }
  .mindmap-node-2 { top: 8%; right: 5%; }
  .mindmap-node-3 { bottom: 8%; left: 5%; }
  .mindmap-node-4 { bottom: 8%; right: 5%; }

  /* Gentle floating animation */
  @media (prefers-reduced-motion: no-preference) {
    .mindmap-node-1 { animation: floatNode1 12s ease-in-out infinite; }
    .mindmap-node-2 { animation: floatNode2 14s ease-in-out infinite; }
    .mindmap-node-3 { animation: floatNode3 13s ease-in-out infinite; }
    .mindmap-node-4 { animation: floatNode4 15s ease-in-out infinite; }
  }

  @keyframes floatNode1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(6px, 4px); }
  }

  @keyframes floatNode2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-5px, 5px); }
  }

  @keyframes floatNode3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(5px, -4px); }
  }

  @keyframes floatNode4 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-6px, -5px); }
  }

  /* Node button */
  .mindmap-node-button {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
    max-width: 180px;
    text-align: left;
    line-height: 1.3;
  }

  .mindmap-node-button:hover,
  .mindmap-node-button:focus {
    border-color: var(--accent);
    background: var(--card-bg);
    outline: none;
  }

  .mindmap-node-button:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .mindmap-node-button[aria-expanded="true"] {
    border-color: var(--accent);
    background: var(--card-bg);
  }

  /* Blurb tooltip */
  .mindmap-blurb {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 280px;
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: 6px;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease;
    z-index: 10;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .mindmap-blurb[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mindmap-blurb p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text);
    margin: 0;
  }

  .mindmap-blurb a {
    color: var(--accent);
  }

  /* Adjust blurb position for right-side nodes */
  .mindmap-node-2 .mindmap-blurb,
  .mindmap-node-4 .mindmap-blurb {
    left: auto;
    right: 0;
  }

  /* Adjust blurb position for bottom nodes */
  .mindmap-node-3 .mindmap-blurb,
  .mindmap-node-4 .mindmap-blurb {
    top: auto;
    bottom: calc(100% + 8px);
    transform: translateY(4px);
  }

  .mindmap-node-3 .mindmap-blurb[aria-hidden="false"],
  .mindmap-node-4 .mindmap-blurb[aria-hidden="false"] {
    transform: translateY(0);
  }

  /* Mobile layout - hidden on desktop */
  .mindmap-mobile {
    display: none;
  }

  .mindmap-mobile-center {
    text-align: center;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .mindmap-mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .mindmap-mobile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
  }

  .mindmap-mobile-card h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .mindmap-mobile-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  .mindmap-mobile-card a {
    color: var(--accent);
  }

  /* Tablet breakpoint */
  @media (max-width: 900px) {
    .mindmap-node-button {
      max-width: 150px;
      font-size: 0.8125rem;
      padding: 0.4rem 0.6rem;
    }

    .mindmap-blurb {
      width: 240px;
    }
  }

  /* Mobile breakpoint - switch to cards */
  @media (max-width: 640px) {
    .mindmap-container {
      display: none;
    }

    .mindmap-mobile {
      display: block;
    }

    .mindmap-mobile-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Hero Landing Section */
  .hero-landing {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-top: 8rem;
  }

  .hero-landing-content {
    text-align: center;
    max-width: 800px;
    padding: 2rem;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 1000ms ease forwards;
    animation-delay: 300ms;
  }

  .profile-photo-large {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2.5rem;
    transition: border-color 300ms ease, transform 300ms ease, box-shadow 300ms ease;
    cursor: pointer;
    overflow: hidden;
  }

  .profile-photo-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-photo-large:hover {
    border-color: var(--accent);
    transform: scale(1.05) rotate(2deg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .hero-name-large {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 25%, #5a6d8a 50%, var(--accent) 75%, var(--accent-secondary) 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 8s ease infinite;
  }

  [data-theme="dark"] .hero-name-large {
    background: linear-gradient(135deg, #95a5b8 0%, var(--accent) 40%, var(--accent-secondary) 100%);
    background-size: 200% 200%;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-tagline {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 600px;
    margin: 0 auto 1.5rem;
  }

  .location-tag {
    display: inline-flex;
    align-items: center;
    margin-bottom: 3rem;
  }

  .location-tag span {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    animation: bounce 3s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(8px); opacity: 0.6; }
  }

  /* Top Navigation */
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 2rem 4rem 1.5rem;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 2.5rem;
    background: var(--bg);
    backdrop-filter: blur(10px);
    z-index: 100;
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 300ms ease, transform 300ms ease, background 200ms ease, top 200ms ease;
    pointer-events: none;
  }

  .top-nav.visible {
    opacity: 0.98;
    transform: translateY(0);
    pointer-events: all;
  }

  .top-nav.pinned {
    position: fixed;
    top: 2.5rem !important;
    left: 0;
    right: 0;
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .nav-left {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .nav-right {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .pin-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.375rem;
    cursor: pointer;
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .pin-toggle:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .pin-toggle.active {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(168, 181, 217, 0.1);
  }

  .pin-toggle.active svg {
    transform: rotate(45deg);
    transition: transform 200ms ease;
  }

  .pin-toggle svg {
    transition: transform 200ms ease;
  }

  @keyframes fadeInDown {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Layout */
  .layout {
    display: flex;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 4rem 6rem;
  }

  /* Sidebar */
  .sidebar {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .sidebar-content > * {
    opacity: 0;
    transform: translateX(-20px);
  }

  .sidebar.animate .sidebar-content > * {
    animation: fadeInLeft 600ms ease forwards;
  }

  .sidebar.animate .sidebar-content > *:nth-child(1) { animation-delay: 100ms; }
  .sidebar.animate .sidebar-content > *:nth-child(2) { animation-delay: 200ms; }
  .sidebar.animate .sidebar-content > *:nth-child(3) { animation-delay: 300ms; }
  .sidebar.animate .sidebar-content > *:nth-child(4) { animation-delay: 400ms; }

  @keyframes fadeInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }


  .section-marker {
    font-size: 0.8125rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-step {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .timeline-dot {
    width: 32px;
    height: 32px;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color 200ms ease;
  }

  .timeline-dot.active {
    border-color: var(--accent);
    border-width: 2px;
  }

  .timeline-logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .timeline-logo-penn {
    width: 30px;
    height: 30px;
  }

  .timeline-label {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .timeline-line {
    width: 2px;
    height: 20px;
    background: var(--border);
    margin-left: 15px;
  }

  /* Top of Mind */
  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .now-list li {
    font-size: 0.9375rem;
    line-height: 1.4;
    padding-left: 1rem;
    position: relative;
  }

  .now-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }

  /* Contact */
  .contact-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .contact-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    border: none;
    transition: color 200ms ease;
  }

  .contact-link:hover {
    color: var(--accent);
    border: none;
  }

  /* Theme Toggle in Nav */
  .theme-toggle-nav {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.125rem;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: color 200ms ease, transform 200ms ease;
    line-height: 1;
  }

  .theme-toggle-nav:hover {
    color: var(--accent);
    transform: scale(1.1);
  }

  .theme-icon-nav {
    display: block;
    line-height: 1;
  }

  /* Main Content */
  .main-content {
    flex: 1;
    max-width: 720px;
  }

  /* When sidebar is hidden (thinking/projects pages) */
  .main-content.full-width {
    max-width: 900px;
    margin: 0 auto;
  }

  .tab-section {
    animation: fadeIn 200ms ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }


  .community-section {
    padding: 1.5rem;
    background: var(--surface);
    border-radius: 6px;
    border: 1px solid var(--border);
    line-height: 1.6;
    opacity: 0;
    transform: translateY(20px);
  }

  #home-view.animate .community-section {
    animation: fadeInUp 600ms ease forwards;
    animation-delay: 1100ms;
  }

  .community-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .community-list li {
    font-size: 0.9375rem;
    line-height: 1.4;
    padding-left: 1rem;
    position: relative;
    margin: 0;
  }

  .community-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }

  .community-photo-container {
    float: right;
    max-width: 280px;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
    transform: rotate(-2deg);
    background: white;
    padding: 8px 8px 24px 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .community-photo {
    width: 100%;
    height: auto;
    display: block;
  }

  .community-photo-caption {
    font-size: 0.8125rem;
    margin-top: 0.5rem;
    line-height: 1.4;
    text-align: center;
  }

  .community-subsection {
    margin-bottom: 1.5rem;
  }

  .community-subsection:last-child {
    margin-bottom: 0;
  }

  .community-subsection-label {
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    text-transform: lowercase;
  }

  .community-list-quiet {
    opacity: 0.85;
  }


  .nav-link {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    border: none;
    transition: color 200ms ease;
  }

  .nav-link:hover {
    color: var(--text);
    border: none;
  }

  .nav-link.active {
    color: var(--accent);
    border: none;
  }

  .section-heading {
    font-size: 1rem;
    margin-bottom: 1.25rem;
    margin-top: 3rem;
    color: var(--muted);
    opacity: 0;
    transform: translateX(-10px);
  }

  #home-view.animate .section-heading {
    animation: fadeInLeft 500ms ease forwards;
  }

  #home-view.animate .section-heading:first-of-type {
    margin-top: 0;
    animation-delay: 600ms;
  }

  #home-view.animate .section-heading:nth-of-type(2) {
    animation-delay: 1000ms;
  }

  /* Thinking Cards */
  .thought-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .thought-card {
    background: var(--surface);
    padding: 1.5rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    opacity: 0;
    transform: translateY(20px);
  }

  #thinking.animate .thought-card {
    animation: fadeInUp 600ms ease forwards;
  }

  #thinking.animate .thought-card:nth-child(1) { animation-delay: 100ms; }
  #thinking.animate .thought-card:nth-child(2) { animation-delay: 200ms; }
  #thinking.animate .thought-card:nth-child(3) { animation-delay: 300ms; }
  #thinking.animate .thought-card:nth-child(4) { animation-delay: 400ms; }
  #thinking.animate .thought-card:nth-child(5) { animation-delay: 500ms; }

  .thought-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
